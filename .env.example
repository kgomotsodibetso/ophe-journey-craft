# Copy to .env for local dev, and set the same values as environment
# variables in your Railway project settings for production.

# Server-side (used during SSR / server functions)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Client-side (Vite inlines these into the browser bundle at build time —
# safe to expose, these are the public/anon Supabase keys, not secrets)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Only needed for server-only admin operations that bypass RLS.
# Keep this out of the client bundle — do not prefix it with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
